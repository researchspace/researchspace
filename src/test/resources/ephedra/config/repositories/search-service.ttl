@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix config: <tag:rdf4j.org,2023:config/> .
@prefix ephedra: <http://www.researchspace.org/resource/system/ephedra#> .
@prefix ex: <http://example.org/ns#> .

[] a config:Repository ;
   config:rep.id "search-service" ;
   rdfs:label "Search Service" ;
   config:rep.impl [
      config:rep.type "openrdf:SailRepository" ;
      config:sail.impl [
         config:sail.type "researchspace:RESTSail" ;
         ephedra:serviceURL "http://localhost:18089/search-service" ;
         ephedra:httpMethod "GET" ;
         ephedra:implementsService ex:SearchService
      ]
   ] .
