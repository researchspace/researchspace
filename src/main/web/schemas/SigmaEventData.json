{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "properties": {
        "Sigma.FocusNode": {
            "description": "Event that listens to an external event that\nfocusses on a given node",
            "properties": {
                "componentId": {
                    "type": "string"
                },
                "node": {
                    "type": "string"
                }
            },
            "propertyOrder": [
                "componentId",
                "node"
            ],
            "required": [
                "node"
            ],
            "type": "object"
        },
        "Sigma.NodeClicked": {
            "description": "Event triggered when a node is clicked.",
            "properties": {
                "attributes": {
                    "description": "Sigma / graphology node attributes."
                },
                "componentId": {
                    "description": "Id of the Sigma component instance that emitted the event.",
                    "type": "string"
                },
                "id": {
                    "description": "Full clicked node id, usually the internal graph node IRI with angle brackets.",
                    "type": "string"
                },
                "node": {
                    "description": "Same clicked node id, clearer alias for consumers.",
                    "type": "string"
                },
                "nodes": {
                    "description": "Node IRIs exposed to external consumers.",
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                }
            },
            "propertyOrder": [
                "componentId",
                "id",
                "node",
                "nodes",
                "attributes"
            ],
            "required": [
                "componentId",
                "id",
                "node",
                "nodes"
            ],
            "type": "object"
        },
        "Sigma.ScatterGroupNode": {
            "description": "Event that listens to an external event and expands the given group node, replacing the group node with its children",
            "properties": {
                "componentId": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "mode": {
                    "enum": [
                        "expand",
                        "replace"
                    ],
                    "type": "string"
                }
            },
            "propertyOrder": [
                "componentId",
                "id",
                "mode"
            ],
            "required": [
                "id",
                "mode"
            ],
            "type": "object"
        },
        "Sigma.TriggerNodeClicked": {
            "description": "External event requesting a click on a given node.",
            "properties": {
                "componentId": {
                    "type": "string"
                },
                "node": {
                    "type": "string"
                }
            },
            "propertyOrder": [
                "componentId",
                "node"
            ],
            "required": [
                "node"
            ],
            "type": "object"
        }
    },
    "propertyOrder": [
        "Sigma.NodeClicked",
        "Sigma.TriggerNodeClicked",
        "Sigma.FocusNode",
        "Sigma.ScatterGroupNode"
    ],
    "required": [
        "Sigma.FocusNode",
        "Sigma.NodeClicked",
        "Sigma.ScatterGroupNode",
        "Sigma.TriggerNodeClicked"
    ],
    "type": "object"
}

