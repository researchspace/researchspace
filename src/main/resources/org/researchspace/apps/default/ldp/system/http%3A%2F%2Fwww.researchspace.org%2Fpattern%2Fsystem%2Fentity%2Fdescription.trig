  _:genid-a532e60a978d45168230f96ee0fa3fa62729-o9uifi a <http://spinrdf.org/sp#Query>;
    <http://spinrdf.org/sp#text> """INSERT { 
    $subject crm:P67i_is_referred_to_by ?information_object  .
    ?information_object a crm:E73_Information_Object .
    ?information_object crm:P2_has_type <http://www.researchspace.org/resource/vocab/text_type/description> .
    ?information_object crm:P1_is_identified_by ?appellation . 
    ?appellation a crm:E41_Appellation . 
    ?appellation crm:P2_has_type <http://www.researchspace.org/resource/system/vocab/resource_type/primary_appellation> . 
    ?appellation crm:P190_has_symbolic_content ?cleanValue .
} WHERE {
  BIND(URI(CONCAT(str($subject), \"/description\")) as ?information_object)
  BIND(URI(CONCAT(STR($subject), \"/description/primary_appellation\") ) as ?appellation)

  # Clean the text (often pasted from web pages) so that templates showing it cannot break.
  # 1. Line breaks: CR LF, CR and the Unicode line and paragraph separators become LF.
  BIND(REPLACE(STR($value), \"\\\\r\\\\n?|[\\\\x{2028}\\\\x{2029}]\", \"\\n\") AS ?clean1)
  # 2. Remove control characters (except tab and LF) and invisible characters:
  #    zero-width space, byte order mark, soft hyphen, word joiner, bidirectional controls.
  BIND(REPLACE(?clean1, \"[\\\\p{Cc}&&[^\\\\t\\\\n]]|[\\\\x{200B}\\\\x{FEFF}\\\\x{00AD}\\\\x{2060}\\\\x{202A}-\\\\x{202E}\\\\x{2066}-\\\\x{2069}]\", \"\") AS ?clean2)
  # 3. Non-breaking and other fixed-width spaces become normal spaces.
  BIND(REPLACE(?clean2, \"[\\\\x{00A0}\\\\x{2007}\\\\x{202F}]\", \" \") AS ?clean3)
  # 4. Straight double quotes become typographic quotes and backslashes a look-alike,
  #    since both break JSON in template attributes. A quote at the start or after a space
  #    or opening bracket, and followed by text, opens; every other quote closes.
  BIND(REPLACE(?clean3, \"(^|[\\\\s(\\\\[])\\\"(?=\\\\S)\", \"$1“\") AS ?clean4)
  BIND(REPLACE(?clean4, \"\\\"\", \"”\") AS ?clean5)
  BIND(REPLACE(?clean5, \"\\\\\\\\\", \"⧵\") AS ?clean6)
  # 5. Separate repeated curly braces, which templates would read as template expressions.
  BIND(REPLACE(?clean6, \"\\\\{(?=\\\\{)\", \"{ \") AS ?clean7)
  BIND(REPLACE(?clean7, \"\\\\}(?=\\\\})\", \"} \") AS ?clean8)
  # 6. Remove leading and trailing white space.
  BIND(REPLACE(?clean8, \"^\\\\s+|\\\\s+$\", \"\") AS ?clean9)
  FILTER(STRLEN(?clean9) > 0)
  # Keep the language or datatype of the value.
  BIND(IF(LANG($value) != \"\", STRLANG(?clean9, LANG($value)), STRDT(?clean9, DATATYPE($value))) AS ?cleanValue)
}
""" .
  
  _:genid-a532e60a978d45168230f96ee0fa3fa62729-zjafbb a <http://spinrdf.org/sp#Query>;
    <http://spinrdf.org/sp#text> """DELETE { 
