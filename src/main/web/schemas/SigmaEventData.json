{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "properties": {
        "Sigma.FocusNode": {
            "description": "Event that listens to an external event that\nfocusses on a given node",
            "properties": {
                "node": {
                    "type": "string"
                }
            },
            "propertyOrder": [
                "node"
            ],
            "required": [
                "node"
            ],
            "type": "object"
        },
        "Sigma.NodeClicked": {
            "description": "Event which should be triggered when a node is clicked",
            "properties": {
                "nodes": {
                    "description": "Node IRI.",
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                }
            },
            "propertyOrder": [
                "nodes"
            ],
            "required": [
                "nodes"
            ],
            "type": "object"
        },
        "Sigma.ScatterGroupNode": {
            "description": "Event that listens to an external event and expands the given group node, replacing the group node with its children",
            "properties": {
                "id": {
                    "type": "string"
                },
                "mode": {
                    "enum": [
                        "expand",
                        "replace"
                    ],
                    "type": "string"
                }
            },
            "propertyOrder": [
                "id",
                "mode"
            ],
            "required": [
                "id",
                "mode"
            ],
            "type": "object"
        },
        "Sigma.TriggerNodeClicked": {
            "description": "Event that listens to a external event that triggers\na click on a given node",
            "properties": {
                "node": {
                    "type": "string"
                }
            },
            "propertyOrder": [
                "node"
            ],
            "required": [
                "node"
            ],
            "type": "object"
        }
    },
    "propertyOrder": [
        "Sigma.NodeClicked",
        "Sigma.TriggerNodeClicked",
        "Sigma.FocusNode",
        "Sigma.ScatterGroupNode"
    ],
    "required": [
        "Sigma.FocusNode",
        "Sigma.NodeClicked",
        "Sigma.ScatterGroupNode",
        "Sigma.TriggerNodeClicked"
    ],
    "type": "object"
}

