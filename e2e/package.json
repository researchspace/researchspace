{
  "name": "researchspace-e2e",
  "version": "0.0.0",
  "private": true,
  "description": "End-to-end (Playwright) tests for ResearchSpace. Run manually against a local dev stack, or in CI.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "install-browsers": "playwright install chromium",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "22.20.1",
    "typescript": "7.0.2"
  }
}
