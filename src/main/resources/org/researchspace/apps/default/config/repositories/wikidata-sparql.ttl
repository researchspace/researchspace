@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix config: <tag:rdf4j.org,2023:config/> .

# QLever Wikidata mirror. Unlike query.wikidata.org (Blazegraph), QLever
# evaluates transitive property paths (wdt:P279*) efficiently without
# vendor-specific query hints, which the import templates rely on for
# domain type filtering.
[] a config:Repository ;
   config:rep.id "wikidata-sparql" ;
   rdfs:label "Wikidata SPARQL Endpoint (QLever)" ;
   config:rep.impl [
      config:rep.type "researchspace:SPARQLRepository" ;
      config:sparql.queryEndpoint <https://qlever.dev/api/wikidata>
   ] .
